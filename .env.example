# ============================================================================
# StudioOS v0.1 — BGP Studios Environment Configuration
# ============================================================================

# 1. Supabase Configuration (PostgreSQL + Supabase Auth)
# Public project URL and anon key for client-side Supabase Auth
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# Server-side Supabase credentials (NEVER expose service_role key to browser)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# 2. Primary Studio Owner Configuration (v0.1 Single-User Setup)
STUDIOOS_OWNER_EMAIL="bgp.studios.hou@gmail.com"
STUDIOOS_OWNER_NAME="BGP Studios Owner"
STUDIOOS_ACCESS_CODE="bgp-studio-01"

# 3. AI Chief-of-Staff Configuration (Server-Side Only)
# Supports OpenAI API (e.g., gpt-4o-mini / gpt-4o) or Gemini API on server
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"

# GEMINI_API_KEY: Automatically injected at runtime in AI Studio environment
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 4. GitHub OAuth & Repository Status Integration (Server-Side Only)
GITHUB_CLIENT_ID="your-github-oauth-app-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-app-client-secret"
GITHUB_DEFAULT_OWNER="bgp-studios"

# 5. Runtime URL
APP_URL="http://localhost:3000"
